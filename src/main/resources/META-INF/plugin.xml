<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>cz.loplex.intellij.bsh</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>BeanShell Language Support</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/loplex/">loplex</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Language support for <b>BeanShell</b> scripts (<code>.bsh</code>).<br>
        <ul>
            <li>Syntax highlighting with a configurable color scheme</li>
            <li>Brace matching, code folding and line/block commenting</li>
            <li>Structural analysis: unbalanced braces, unterminated strings and comments</li>
            <li>Run BeanShell scripts from the editor via a dedicated run configuration</li>
        </ul>
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="BeanShell"
            implementationClass="cz.loplex.intellij.bsh.BshFileType"
            fieldName="INSTANCE"
            language="BeanShell"
            extensions="bsh"/>

        <lang.parserDefinition
            language="BeanShell"
            implementationClass="cz.loplex.intellij.bsh.BshParserDefinition"/>

        <lang.syntaxHighlighterFactory
            language="BeanShell"
            implementationClass="cz.loplex.intellij.bsh.highlight.BshSyntaxHighlighterFactory"/>

        <colorSettingsPage
            implementation="cz.loplex.intellij.bsh.highlight.BshColorSettingsPage"/>

        <lang.braceMatcher
            language="BeanShell"
            implementationClass="cz.loplex.intellij.bsh.editor.BshBraceMatcher"/>

        <lang.commenter
            language="BeanShell"
            implementationClass="cz.loplex.intellij.bsh.editor.BshCommenter"/>

        <lang.foldingBuilder
            language="BeanShell"
            implementationClass="cz.loplex.intellij.bsh.editor.BshFoldingBuilder"/>

        <annotator
            language="BeanShell"
            implementationClass="cz.loplex.intellij.bsh.analysis.BshAnnotator"/>

        <lang.psiStructureViewFactory
            language="BeanShell"
            implementationClass="cz.loplex.intellij.bsh.structure.BshStructureViewFactory"/>

        <lang.findUsagesProvider
            language="BeanShell"
            implementationClass="cz.loplex.intellij.bsh.findusages.BshFindUsagesProvider"/>

        <lang.namesValidator
            language="BeanShell"
            implementationClass="cz.loplex.intellij.bsh.reference.BshNamesValidator"/>

        <completion.contributor
            language="BeanShell"
            implementationClass="cz.loplex.intellij.bsh.completion.BshCompletionContributor"/>

        <gotoSymbolContributor
            implementation="cz.loplex.intellij.bsh.navigation.BshChooseByNameContributor"/>

        <lang.formatter
            language="BeanShell"
            implementationClass="cz.loplex.intellij.bsh.formatting.BshFormattingModelBuilder"/>

        <lang.documentationProvider
            language="BeanShell"
            implementationClass="cz.loplex.intellij.bsh.documentation.BshDocumentationProvider"/>

        <liveTemplateContext
            contextId="BEANSHELL"
            implementation="cz.loplex.intellij.bsh.template.BshTemplateContextType"/>

        <defaultLiveTemplates file="liveTemplates/BeanShell"/>

        <codeInsight.parameterInfo
            language="BeanShell"
            implementationClass="cz.loplex.intellij.bsh.completion.BshParameterInfoHandler"/>

        <indexPatternBuilder
            implementation="cz.loplex.intellij.bsh.analysis.BshIndexPatternBuilder"/>

        <breadcrumbsInfoProvider
            implementation="cz.loplex.intellij.bsh.navigation.BshBreadcrumbsProvider"/>

        <localInspection
            language="BeanShell"
            shortName="BshUnusedVariable"
            displayName="Unused variable"
            groupName="BeanShell"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="cz.loplex.intellij.bsh.inspection.BshUnusedVariableInspection"/>

        <localInspection
            language="BeanShell"
            shortName="BshUnreachableCode"
            displayName="Unreachable code"
            groupName="BeanShell"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="cz.loplex.intellij.bsh.inspection.BshUnreachableCodeInspection"/>

        <configurationType
            implementation="cz.loplex.intellij.bsh.run.BshRunConfigurationType"/>

        <runConfigurationProducer
            implementation="cz.loplex.intellij.bsh.run.BshRunConfigurationProducer"/>
    </extensions>

</idea-plugin>
