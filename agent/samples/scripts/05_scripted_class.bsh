// Scripted classes: the ONE place real bytecode is generated.
//
// ClassGeneratorImpl + the bundled ASM emit a genuine Java class, but each
// generated method is only a shim: ClassGeneratorUtil.generateMethod()
// (ClassGeneratorUtil.java:342, see comment at :339) emits
//   INVOKEVIRTUAL bsh/This.invokeMethod   (ClassGeneratorUtil.java:388-390)
// so the body is still interpreted from the AST.
//
// Consequences for a debugger:
//   - A JVM-level stack trace here shows the generated class frame, then
//     bsh.This.invokeMethod, then a pile of bsh.BSH* frames. The script-level
//     frame is NOT in the Java stack -- it is only in the bsh CallStack.
//   - Stepping "into" a scripted class method crosses a bytecode boundary and
//     comes back out into the interpreter. Your stepper has to treat
//     This.invokeMethod as a frame entry, not as a Java call to step over.
//
// Hook points exercised:
//   This.java:208           entry from the generated bytecode
//   BshMethod.java:204      the actual method body invocation
//   ClassGeneratorImpl:266  insureNodesParsed at class generation time

print("=== 05_scripted_class ===");

// GOTCHA, verified: the constructor and any method a subclass touches MUST be
// declared `public`. Without it you get, at `new Point3D(...)`:
//   java.lang.IllegalAccessError: tried to access method Point.<init>(II)V
//                                 from class Point3D
// Reason: each generated class gets its own BshClassLoader, so "same package"
// does not hold across them at runtime and package-private access fails.
// Worth knowing before you blame your agent for it.
class Point {
    int x;
    int y;
    static int created = 0;

    public Point(int x, int y) {
        this.x = x;                     // BP:1  constructor body
        this.y = y;
        Point.created++;
    }

    public int getX() {
        return this.x;                  // BP:2  reached via the bytecode shim
    }

    public int distanceSquared() {
        return this.x * this.x + this.y * this.y;    // BP:3
    }

    public String describe() {
        return "Point(" + this.x + "," + this.y + ")";   // BP:4
    }

    public static int getCreated() {
        return Point.created;           // BP:5  static -> no This instance
    }
}

p = new Point(3, 4);                    // BP:6  triggers class generation once
print("p = " + p.describe());
print("p.getX() = " + p.getX());        // BP:7  Java call -> shim -> AST
print("d2 = " + p.distanceSquared());
print("created = " + Point.getCreated());

// Real Java type: this is why the bytecode exists at all.
print("is a Point: " + (p instanceof Point));
print("java class: " + p.getClass().getName());   // BP:8

// Inheritance: super delegate methods are generated too
// (generateSuperDelegateMethod, ClassGeneratorUtil.java:295).
class Point3D extends Point {
    int z;

    public Point3D(int x, int y, int z) {
        super(x, y);                    // BP:9  super ctor across the shim
        this.z = z;
    }

    public String describe() {
        return "Point3D(" + this.x + "," + this.y + "," + this.z + ")";  // BP:10
    }
}

q = new Point3D(1, 2, 3);
print("q = " + q.describe());           // BP:11 overridden, dynamic dispatch
print("q as Point: " + ((Point) q).getX());

// Implementing a Java interface with a scripted class: now Java code calling
// compare() enters through the shim with caller node = SimpleNode.JAVACODE,
// i.e. getLineNumber() == -1. Your position mapper must handle that.
class ByLength implements java.util.Comparator {
    public int compare(Object a, Object b) {
        return a.toString().length() - b.toString().length();    // BP:12
    }
}

words = new java.util.ArrayList();
words.add("ccc");
words.add("a");
words.add("bb");
java.util.Collections.sort(words, new ByLength());   // BP:13 Java drives the script
print("sorted = " + words);

print("05_scripted_class done");
