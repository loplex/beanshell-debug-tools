<?xml version="1.0" encoding="UTF-8"?>
<!--
  Inline BeanShell inside the build-helper-maven-plugin's bsh-property goal (<source>).
  The <source> is a BeanShell expression whose value is stored into the named property.
  The mojo binds a `project` variable, so it can be referenced directly. Set a breakpoint
  on a line below and run the "bsh-property" goal in Debug.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example.bsh</groupId>
    <artifactId>build-helper</artifactId>
    <version>1.0.0</version>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <source><![CDATA[
                        name = project.artifactId + ":" + project.version;
                        total = 0;
                        for (i = 1; i <= 3; i++) {
                            total += i;
                            print("Building " + name + " step " + i);
                        }
                        print("sum = " + total);
                        buildTag = project.artifactId + "-" + total;
                        ]]></source>
                    <properties>
                        <property>buildTag</property>
                    </properties>
                </configuration>
                <executions>
                    <execution>
                        <id>default-cli</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>bsh-property</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
